#cloud-config
# Minimal bootstrap ONLY. The real node build (sing-box, transports, firewall,
# health) is done by Ansible over SSH from the operator — this just makes the
# host reachable and Ansible-ready fast (<5 min target: no compilation here).
hostname: ${hostname}
preserve_hostname: false

users:
  - name: ${ops_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_pubkey}

package_update: true
packages:
  - python3
  - nftables
  - curl
  - ca-certificates

write_files:
  - path: /etc/caspervpn/role
    permissions: "0644"
    content: |
      ${role}
  - path: /etc/caspervpn/ready
    permissions: "0644"
    content: |
      bootstrap-ok

runcmd:
%{ if ip_forward ~}
  - [ sysctl, -w, net.ipv4.ip_forward=1 ]
  - [ sysctl, -w, net.ipv6.conf.all.forwarding=1 ]
  - [ sh, -c, "printf 'net.ipv4.ip_forward=1\nnet.ipv6.conf.all.forwarding=1\n' > /etc/sysctl.d/99-caspervpn.conf" ]
%{ endif ~}
  - [ systemctl, enable, --now, nftables ]
