[Unit]
Description=Check CasperVPN local service health transitions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=caspervpn
Group=caspervpn
WorkingDirectory=/opt/caspervpn
EnvironmentFile=-/etc/caspervpn/operations.env
UMask=0077
ExecStart=/usr/bin/python3 /opt/caspervpn/scripts/maintenance.py --env /opt/caspervpn/.launch/production.env monitor
StateDirectory=caspervpn/monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caspervpn/monitor
IPAddressDeny=any
IPAddressAllow=localhost
