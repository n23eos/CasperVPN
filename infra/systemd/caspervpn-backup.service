[Unit]
Description=Create and verify encrypted CasperVPN backup bundle
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=caspervpn
Group=caspervpn
WorkingDirectory=/opt/caspervpn
EnvironmentFile=/etc/caspervpn/operations.env
UMask=0077
ExecStart=/usr/bin/python3 /opt/caspervpn/scripts/maintenance.py --env /opt/caspervpn/.launch/production.env backup
TimeoutStartSec=2h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
