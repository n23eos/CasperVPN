[Unit]
Description=Refresh CasperVPN node access leases
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/caspervpn
EnvironmentFile=/etc/caspervpn/access-reconcile.env
UMask=0077
ExecStart=/opt/caspervpn/infra/scripts/reconcile_fleet_access.sh
TimeoutStartSec=15min
Nice=10

[Install]
WantedBy=multi-user.target
